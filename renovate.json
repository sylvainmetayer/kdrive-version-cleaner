{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    ":semanticCommitsDisabled"
  ],
  "timezone": "Europe/Paris",
  "schedule": ["before 6am on monday"],
  "minimumReleaseAge": "3 days",
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Extension gh-actions-lock épinglée dans verify-lockfile.yml (--pin vX.Y.Z)",
      "managerFilePatterns": ["/^\\.github/workflows/verify-lockfile\\.yml$/"],
      "matchStrings": ["--pin (?<currentValue>v\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "github/gh-actions-lock",
      "datasourceTemplate": "github-releases"
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "schedule": ["at any time"],
    "minimumReleaseAge": null
  },
  "packageRules": [
    {
      "description": "Mises à jour mineures et correctives groupées",
      "matchUpdateTypes": ["minor", "patch", "digest", "pin"],
      "groupName": "dépendances (mineures)"
    },
    {
      "description": "Correctives, digests et pins fusionnés automatiquement, CI verte requise",
      "matchUpdateTypes": ["patch", "digest", "pin", "pinDigest"],
      "automerge": true
    },
    {
      "description": "Mineures des versions >= 1.0 : fusion automatique, CI verte requise",
      "matchUpdateTypes": ["minor"],
      "matchCurrentVersion": "!/^0\\./",
      "automerge": true
    },
    {
      "description": "Mineures 0.x : potentiellement cassantes (semver Cargo), PR à part et fusion manuelle",
      "matchUpdateTypes": ["minor"],
      "matchCurrentVersion": "/^0\\./",
      "groupName": "dépendances 0.x (mineures)",
      "automerge": false
    },
    {
      "description": "gh-actions-lock : PR à part, jamais d'automerge (0.x, format du verrou encore mouvant)",
      "matchDepNames": ["github/gh-actions-lock"],
      "groupName": "gh-actions-lock",
      "automerge": false
    }
  ]
}
